# Compilers that warn apart about designated initializers that leave fields out take a switch of its own for it, while the others report them as missing field initializers.
include(CheckCXXCompilerFlag)
if(NOT MSVC)
  check_cxx_compiler_flag(-Wmissing-designated-field-initializers HAYLEN_SHADERC_DESIGNATED_INITIALIZER_WARNING)
endif()

function(haylen_shaderc_enable_warnings target)
  if(MSVC)
    target_compile_options(${target} PRIVATE /W4 /permissive- /Zc:preprocessor /utf-8)
  else()
    target_compile_options(${target} PRIVATE -Wall -Wextra -Wpedantic -Wconversion -Wsign-conversion -Wshadow)
    # Designated initializers that leave fields to their default member values are the intended style.
    if(HAYLEN_SHADERC_DESIGNATED_INITIALIZER_WARNING)
      target_compile_options(${target} PRIVATE -Wno-missing-designated-field-initializers)
    else()
      target_compile_options(${target} PRIVATE -Wno-missing-field-initializers)
    endif()
  endif()
endfunction()

# Builds the targets of a dependency without warnings. Its project gives its own code the warning flags of that project, in the compile options or in the older compile flags of its targets, and only that project can act on what they find, so those flags give way to the switch that turns warnings off.
function(haylen_shaderc_disable_warnings)
  foreach(target IN LISTS ARGN)
    get_target_property(options ${target} COMPILE_OPTIONS)
    if(options)
      list(FILTER options EXCLUDE REGEX "(^|:)([-/]W[0-4X]|[-/]Wall|[-/]w[de][0-9]+|-W[a-z].*|-Werror)(>|$)")
      set_property(TARGET ${target} PROPERTY COMPILE_OPTIONS ${options})
    endif()
    get_target_property(flags ${target} COMPILE_FLAGS)
    if(flags)
      separate_arguments(flags)
      list(FILTER flags EXCLUDE REGEX "^([-/]W[0-4X]|[-/]Wall|[-/]w[de][0-9]+|-W[a-z].*|-Werror.*)$")
      list(JOIN flags " " flags)
      set_property(TARGET ${target} PROPERTY COMPILE_FLAGS "${flags}")
    endif()
    if(MSVC)
      target_compile_options(${target} PRIVATE /W0)
    else()
      target_compile_options(${target} PRIVATE -w)
    endif()
  endforeach()
endfunction()

# Builds every compiled target that a dependency defines in its source folder and the folders under it without warnings, for dependencies made of many libraries.
function(haylen_shaderc_disable_folder_warnings folder)
  get_property(targets DIRECTORY "${folder}" PROPERTY BUILDSYSTEM_TARGETS)
  foreach(target IN LISTS targets)
    get_target_property(type ${target} TYPE)
    if(type MATCHES "^(STATIC_LIBRARY|SHARED_LIBRARY|MODULE_LIBRARY|OBJECT_LIBRARY|EXECUTABLE)$")
      haylen_shaderc_disable_warnings(${target})
    endif()
  endforeach()

  get_property(folders DIRECTORY "${folder}" PROPERTY SUBDIRECTORIES)
  foreach(child IN LISTS folders)
    haylen_shaderc_disable_folder_warnings("${child}")
  endforeach()
endfunction()
